npts 40 40 40                        # num.grid points in xyz
gridfld 1EVE_A_clean_pdb_final.maps.fld # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C HD N NA OA SA       # ligand atom types
receptor 1EVE_A_clean_pdb_final.pdbqt # macromolecule
gridcenter 5.029 65.049 55.8         # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 1EVE_A_clean_pdb_final.A.map     # atom-specific affinity map
map 1EVE_A_clean_pdb_final.C.map     # atom-specific affinity map
map 1EVE_A_clean_pdb_final.HD.map    # atom-specific affinity map
map 1EVE_A_clean_pdb_final.N.map     # atom-specific affinity map
map 1EVE_A_clean_pdb_final.NA.map    # atom-specific affinity map
map 1EVE_A_clean_pdb_final.OA.map    # atom-specific affinity map
map 1EVE_A_clean_pdb_final.SA.map    # atom-specific affinity map
elecmap 1EVE_A_clean_pdb_final.e.map # electrostatic potential map
dsolvmap 1EVE_A_clean_pdb_final.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
